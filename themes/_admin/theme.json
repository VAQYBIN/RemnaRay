{
  "$schema": "https://remnaray.dev/schema/theme.v1.json",
  "slug": "_admin",
  "name": "Admin",
  "version": 1,
  "brand": {
    "name": "RemnaRay Admin",
    "tagline": { "ru": "Управление магазином", "en": "Store administration" }
  },
  "colors": {
    "primary": "#1D4ED8",
    "primary-foreground": "#FFFFFF",
    "secondary": "#475569",
    "accent": "#FACC15",
    "accent-foreground": "#172033",
    "background": "#F8FAFC",
    "foreground": "#172033",
    "surface": "#FFFFFF",
    "muted": "#E2E8F0",
    "muted-foreground": "#334155",
    "border": "#CBD5E1",
    "ring": "#1D4ED8",
    "success": "#15803D",
    "warning": "#B45309",
    "danger": "#B91C1C",
    "dark": {
      "background": "#172033",
      "foreground": "#F8FAFC",
      "surface": "#1E293B",
      "muted": "#334155",
      "muted-foreground": "#CBD5E1",
      "border": "#475569"
    }
  },
  "typography": {
    "sans": "Inter, system-ui, sans-serif",
    "mono": "JetBrains Mono, ui-monospace, monospace",
    "fonts": []
  },
  "radius": { "sm": "0.375rem", "md": "0.5rem", "lg": "0.75rem" },
  "assets": {
    "logo": "logo.svg",
    "logoDark": "logo-dark.svg",
    "mark": "logo-mark.svg",
    "mascot": {
      "default": "mascot.svg",
      "empty": "mascot-empty.svg",
      "error": "mascot-error.svg",
      "success": "mascot-success.svg"
    },
    "og": "og.png",
    "favicon": "favicon.svg",
    "appleTouchIcon": "apple-touch-icon.png",
    "botAvatar": "bot-avatar.png"
  },
  "landing": { "heroStyle": "wave", "showMascot": false }
}
