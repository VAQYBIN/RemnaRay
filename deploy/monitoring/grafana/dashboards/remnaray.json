      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "remnaray-prometheus"
          },
          "expr": "sum by (provider, status) (increase(rr_invoices_total[$__rate_interval]))",
          "legendFormat": "{{provider}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Provider events",
      "description": "A webhook that was refused is as worth seeing as one that applied.",
