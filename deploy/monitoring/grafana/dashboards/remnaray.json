    {
      "id": 11,
      "type": "stat",
      "title": "Certificate expiry",
      "description": "Negative once the certificate has expired; the application alerts below fourteen days (section 19.2).",
      "datasource": {
        "type": "prometheus",
        "uid": "remnaray-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
