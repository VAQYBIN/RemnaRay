{
  "uid": "remnaray",
  "title": "RemnaRay",
  "description": "Section 20.2: revenue, invoices by provider, queues, the panel, errors and TLS.",
  "tags": ["remnaray"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Revenue recognised",
      "description": "Money that reached the revenue account, in roubles. Minor units divided by 100 (section 12.2).",
      "datasource": {
        "type": "prometheus",
        "uid": "remnaray-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyRUB",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "remnaray-prometheus"
          },
          "expr": "sum by (provider) (increase(rr_revenue_minor_total[$__rate_interval])) / 100",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Invoices by provider and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "remnaray-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
