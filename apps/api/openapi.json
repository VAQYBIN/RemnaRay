{
  "openapi": "3.0.3",
  "info": { "title": "RemnaRay API", "version": "0.1.0" },
  "paths": {
    "/api/v1/auth/telegram": {
      "post": {
        "operationId": "telegramLogin",
        "responses": { "200": { "description": "Authenticated user" } }
      }
    },
    "/api/v1/auth/logout": {
      "post": { "operationId": "logout", "responses": { "204": { "description": "Logged out" } } }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": { "200": { "description": "Current user" } }
      }
    },
    "/api/internal/v1/auth/issue-token": {
      "post": {
        "operationId": "issueBotToken",
        "responses": { "200": { "description": "Bot JWT" } }
      }
    },
    "/api/internal/v1/ledger/users/{userId}/available": {
      "get": {
        "operationId": "getLedgerAvailable",
        "responses": { "200": { "description": "Spendable balance in minor units" } }
      }
    },
    "/api/internal/v1/users/upsert": {
      "post": {
        "operationId": "upsertInternalUser",
        "responses": { "200": { "description": "Upserted user" } }
      }
    },
    "/api/admin/v1/settings": {
      "get": {
        "operationId": "getSettings",
        "responses": { "200": { "description": "Grouped settings" } }
      },
      "put": {
        "operationId": "updateSettings",
        "responses": { "200": { "description": "Updated settings" } }
      }
    },
    "/api/admin/v1/settings/schema": {
      "get": {
        "operationId": "getSettingsSchema",
        "responses": { "200": { "description": "Settings schema" } }
      }
    },
    "/api/admin/v1/settings/export": {
      "get": {
        "operationId": "exportSettings",
        "responses": { "200": { "description": "Safe settings snapshot" } }
      }
    },
    "/api/admin/v1/settings/import": {
      "post": {
        "operationId": "importSettings",
        "responses": { "200": { "description": "Imported settings" } }
      }
    }
  }
}
