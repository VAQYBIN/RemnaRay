{
  "name": "remnaray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "~3.0.3",
    "@commitlint/cli": "~21.2.2",
    "@commitlint/config-conventional": "~21.2.2",
    "@eslint/js": "~10.0.1",
    "@remnaray/eslint-config": "workspace:*",
    "eslint": "~10.10.0",
    "husky": "~9.1.7",
    "lint-staged": "~17.5.1",
    "prettier": "~3.9.8",
    "turbo": "~2.11.0",
    "typescript": "~7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
