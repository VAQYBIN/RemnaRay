{
  "name": "remnaray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "theme-validate": "tsx tools/theme-validate.ts",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "node --test test/tooling.test.mjs",
    "test:m1": "pnpm build && node --test test/m1.integration.test.mjs",
    "test:m2": "pnpm build && node --test test/m2.payment.integration.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "~3.0.3",
    "@testcontainers/postgresql": "~12.1.0",
    "@commitlint/cli": "~21.2.2",
    "@commitlint/config-conventional": "~21.2.2",
    "@eslint/js": "~10.0.1",
    "@remnaray/eslint-config": "workspace:*",
    "eslint": "~10.10.0",
    "husky": "~9.1.7",
    "lint-staged": "~17.5.1",
    "prettier": "~3.9.8",
    "turbo": "~2.11.0",
    "typescript": "~7.0.2",
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@playwright/test": "~1.63.0",
    "@types/node": "~24.13.6",
    "pino-pretty": "~13.1.3",
    "testcontainers": "~12.1.0",
    "tsx": "~4.23.13",
    "vitest": "~5.0.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
