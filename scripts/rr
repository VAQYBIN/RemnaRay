#!/usr/bin/env sh
set -eu

command=${1:-help}
compose_file=${COMPOSE_FILE:-compose.yaml}

# NFR-013: one start command per profile. The profile comes from `.env`, so the
# owner never types it and never edits a proxy configuration by hand.
if [ -f .env ]; then
  # shellcheck disable=SC2046
  export $(grep -E '^(RR_PROXY_PROFILE|RR_TLS_MODE)=' .env | xargs) 2>/dev/null || true
fi
profile=${RR_PROXY_PROFILE:-nginx}
tls_mode=${RR_TLS_MODE:-acme}

set -- "$@"
profiles="--profile $profile"
if [ "$tls_mode" = "certbot" ]; then
  profiles="$profiles --profile certbot"
fi

usage() {
  cat <<USAGE
Usage: ./scripts/rr {up|down|logs|ps|config|proxy:render|proxy:reload|tls:issue|backup|restore|theme:validate}

The proxy profile comes from RR_PROXY_PROFILE in .env (default: nginx), and
RR_TLS_MODE=certbot adds the certbot profile.

Set COMPOSE_FILE=compose.dev.yaml for the local PostgreSQL/Valkey dependencies.
USAGE
}

case "$command" in
  up)
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" $profiles up -d
    ;;
  down)
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" $profiles down
    ;;
  logs)
    shift
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" $profiles logs "$@"
    ;;
  ps)
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" $profiles ps
    ;;
  config)
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" $profiles config
    ;;
  proxy:render)
    # Re-render the proxy configuration without waiting for a settings change.
    docker compose -f "$compose_file" restart proxy-config
    ;;
  tls:issue)
    # Section 21.3: the first certificate of the `certbot` mode. nginx is
    # already serving the HTTP-only bootstrap configuration, which answers the
    # HTTP-01 challenge from the shared webroot.
    if [ "$tls_mode" != "certbot" ]; then
      echo "tls:issue applies to RR_TLS_MODE=certbot; this deployment uses $tls_mode" >&2
      exit 1
    fi
    domain=$(grep -E '^RR_DOMAIN=' .env | cut -d= -f2-)
    email=$(grep -E '^RR_ACME_EMAIL=' .env | cut -d= -f2-)
    docker compose -f "$compose_file" --profile certbot run --rm certbot \
      certonly --webroot -w /var/www/certbot -d "$domain" -m "$email" --agree-tos -n
    # The certificate exists now, so the full configuration renders.
    docker compose -f "$compose_file" restart proxy-config
    ;;
  proxy:reload)
    # Ask `proxy-reloader` to validate and apply what is currently rendered.
    docker compose -f "$compose_file" exec -T valkey \
      valkey-cli publish rr:proxy.reload '{"reason":"manual"}'
    ;;
  backup)
    # Section 20.5: the same script the schedule runs, on demand.
    docker compose -f "$compose_file" run --rm backup /scripts/backup-entrypoint.sh once
    ;;
  restore)
    shift
    if [ $# -lt 1 ]; then
      echo "Usage: ./scripts/rr restore backups/<file>.dump" >&2
      exit 2
    fi
    # The dump is named as the host sees it; the container mounts `./backups`.
    docker compose -f "$compose_file" run --rm backup \
      /scripts/restore.sh "/backups/$(basename "$1")"
    ;;
  theme:validate)
    shift
    pnpm theme-validate "${1:-themes/manta}"
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
